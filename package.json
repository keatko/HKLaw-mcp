{
  "name": "hong-kong-law-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Hong Kong law research MCP backed by official HKeL open data.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 execute hk-law --local --file=./migrations/0001_init.sql",
    "db:migrate:remote": "wrangler d1 execute hk-law --remote --file=./migrations/0001_init.sql",
    "ingest:hk": "tsx ./scripts/ingest-hkel.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "agents": "0.20.1",
    "fast-xml-parser": "5.10.1",
    "unzipper": "0.12.5",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260405.1",
    "@types/node": "26.1.1",
    "@types/unzipper": "0.10.11",
    "tsx": "4.22.5",
    "typescript": "5.9.2",
    "wrangler": "4.115.0"
  }
}
